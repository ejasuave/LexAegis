{
  "name": "@lexaegis/indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Envio HyperIndex projection of ProofOfReviewRegistry events (read-only).",
  "scripts": {
    "config:generate": "tsx scripts/generate-config.ts",
    "config:check": "tsx scripts/generate-config.ts --check",
    "codegen": "pnpm config:generate && envio codegen",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "dev": "pnpm config:generate && tsx scripts/run.ts dev",
    "start": "pnpm config:check && tsx scripts/verify-binding.ts && tsx scripts/run.ts start",
    "rebuild": "tsx scripts/rebuild.ts",
    "verify:binding": "tsx scripts/verify-binding.ts",
    "evidence:rpc": "tsx scripts/rpc-evidence-run.ts"
  },
  "dependencies": {
    "envio": "3.13.0"
  },
  "devDependencies": {
    "@lexaegis/sdk": "workspace:*",
    "viem": "2.57.3",
    "zod": "4.6.5",
    "tsx": "4.23.15",
    "pg": "8.23.1",
    "@types/pg": "8.23.1"
  }
}
