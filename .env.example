# Server-only configuration. Every value is optional so both application shells can boot.
# Leave secrets empty in version control. Never prefix a secret with NEXT_PUBLIC_ or VITE_.

# Ports (local development)
WEB_PORT=3000
VERIFIER_PORT=5173

# Qwen (Chapter 9). The model, region and provider are never substituted silently.
# QWEN_BASE_URL must be a documented Model Studio endpoint ending in /compatible-mode/v1, for
# example https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1.
# QWEN_OUTPUT_MODE is json_schema (default) or json_object; it is never switched automatically.
# Real-matter inference stays off until `pnpm qwen:smoke` verifies this exact endpoint, model
# and output mode (needs DATABASE_URL). Selected text sent for analysis reaches the provider.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.8-max
QWEN_OUTPUT_MODE=
# Optional ceilings. They can lower the built-in limits, never raise them.
ASSISTANT_RUN_SECONDS=
ASSISTANT_MAX_PROVIDER_ATTEMPTS=
ASSISTANT_MAX_TOOL_CALLS=
ASSISTANT_DAILY_RUNS_PER_ACCOUNT=
ASSISTANT_DAILY_RUNS_GLOBAL=
ASSISTANT_ACTIVE_RUNS_GLOBAL=

# Alchemy Monad RPC (Chapter 6)
ALCHEMY_MONAD_RPC_URL=

# Envio HyperIndex GraphQL (Chapter 7)
ENVIO_GRAPHQL_URL=
ENVIO_API_TOKEN=
# Indexer process only (indexer/): its own disposable PostgreSQL role and database, never the
# application's DATABASE_URL. The database name must start with lexaegis_indexer for pnpm
# --filter @lexaegis/indexer rebuild. ENVIO_INDEX_GENERATION is set by the launcher.
ENVIO_PG_HOST=
ENVIO_PG_PORT=
ENVIO_PG_USER=
ENVIO_PG_PASSWORD=
ENVIO_PG_DATABASE=

# PostgreSQL: sign-in challenges and backend login sessions (and later operational metadata).
# Local development: run `pnpm db:dev` and paste the DATABASE_URL it prints. Without it,
# account sign-in is unavailable; there is no fallback.
DATABASE_URL=

# S3-compatible ciphertext storage (Chapter 5). All five are required, with DATABASE_URL, for the
# vault; without them vault routes return NOT_CONFIGURED (no in-process fallback). The server must
# support conditional create (If-None-Match: *); this is probed once per process. Local development:
# `pnpm tools:s3` installs the pinned VersityGW. Hosting must allow 16 MiB request bodies on
# /api/vault/*/objects/* (a Chapter 13 requirement).
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Monad testnet funding and deployment (Chapter 6). Testnet-only, operator-owned accounts that are
# separate from each other and from every user's Mera key. Funding stays off until the flag is
# exactly "true". Limits are decimal MON; unset values use the defaults shown. AUTH_SESSION_SECRET
# is reserved and unused: backend sessions are random tokens stored as hashes.
TESTNET_FUNDER_PRIVATE_KEY=
TESTNET_DEPLOYER_PRIVATE_KEY=
TESTNET_FUNDING_ENABLED=false
# TESTNET_FUNDING_GRANT_MON=0.2
# TESTNET_FUNDING_DAILY_BUDGET_MON=10
# TESTNET_FUNDING_MAX_FEE_MON=0.01
# TESTNET_REGISTRY_MAX_FEE_MON=0.2
# TESTNET_DEPLOY_MAX_FEE_MON=2
AUTH_SESSION_SECRET=

# Browser-visible configuration (allowlisted; no secrets)
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_VERIFIER_ORIGIN=http://localhost:5173
NEXT_PUBLIC_WEBAUTHN_RP_ID=localhost
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_REGISTRY_ADDRESS=

# Verifier browser configuration (public values only)
VITE_CHAIN_ID=10143
VITE_REGISTRY_ADDRESS=

# Optional product features (server-only; exactly "true" or "false"; restart to apply).
# Voice, comparison, briefing and reputation feedback default to false. Agent identity and matter
# notes default to on only once implemented and verified. An explicit true never bypasses that.
FEATURE_VOICE=
FEATURE_DOCUMENT_COMPARISON=
FEATURE_MATTER_BRIEFING=
FEATURE_REPUTATION_FEEDBACK=
FEATURE_AGENT_IDENTITY=
FEATURE_MATTER_NOTES=
