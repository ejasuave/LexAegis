{
  "name": "lexaegis",
  "private": true,
  "version": "0.0.0",
  "description": "Proof of Review monorepo: open protocol, SDK, verifier and the LexAegis reference application.",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lexaegis/web dev",
    "dev:verifier": "pnpm --filter @lexaegis/verifier dev",
    "lint": "node --max-old-space-size=6144 ./node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "test:protocol": "vitest run --project protocol",
    "test:protocol:browser": "pnpm --filter @lexaegis/protocol test:browser",
    "protocol:generate": "pnpm --filter @lexaegis/protocol generate",
    "protocol:check": "pnpm --filter @lexaegis/protocol generate:check",
    "fixtures:generate": "node fixtures/protocol-v1/generate.mjs && node fixtures/registry-v1/generate.mjs && node fixtures/account-v1/generate.mjs && node fixtures/vault-v1/generate.mjs && node fixtures/documents-v1/generate.mjs",
    "fixtures:check": "node fixtures/protocol-v1/generate.mjs --check && node fixtures/registry-v1/generate.mjs --check && node fixtures/account-v1/generate.mjs --check && node fixtures/vault-v1/generate.mjs --check && node fixtures/documents-v1/generate.mjs --check",
    "contracts:toolchain": "pnpm --filter @lexaegis/contracts toolchain",
    "contracts:fmt:check": "pnpm --filter @lexaegis/contracts fmt:check",
    "contracts:build": "pnpm --filter @lexaegis/contracts compile",
    "contracts:test": "pnpm --filter @lexaegis/contracts test:forge",
    "contracts:artifacts": "pnpm --filter @lexaegis/contracts artifacts",
    "contracts:artifacts:check": "pnpm --filter @lexaegis/contracts artifacts:check",
    "contracts:deploy:local": "pnpm --filter @lexaegis/contracts deploy:local",
    "test:contracts:integration": "pnpm --filter @lexaegis/contracts test:integration",
    "scope:docs": "tsx tooling/scripts/scope-docs.ts",
    "scope:docs:check": "tsx tooling/scripts/scope-docs.ts --check",
    "state:validate": "tsx tooling/scripts/validate-state.ts",
    "baselines:check": "tsx tooling/scripts/baselines.ts --check",
    "exclusion:check": "tsx tooling/scripts/exclusion-scan.ts",
    "secrets:check": "tsx tooling/scripts/secrets-scan.ts",
    "prf:probe": "tsx tooling/scripts/prf-probe.ts",
    "readiness": "tsx tooling/scripts/readiness.ts",
    "smoke:local": "tsx tooling/scripts/smoke-local.ts",
    "smoke:testnet": "tsx tooling/scripts/smoke-testnet.ts",
    "cutladder:check": "tsx tooling/scripts/cut-ladder.ts",
    "db:dev": "tsx tooling/scripts/db-dev.ts",
    "db:migrate": "tsx tooling/scripts/db-migrate.ts",
    "test:auth:db": "pnpm --filter @lexaegis/web test:db",
    "test:account:browser": "tsx tooling/scripts/account-browser-check.ts",
    "test:vault:browser": "tsx tooling/scripts/vault-browser-check.ts",
    "account:record-device-check": "tsx tooling/scripts/record-device-check.ts",
    "tools:s3": "tsx tooling/scripts/install-versitygw.ts",
    "contracts:deploy:testnet": "pnpm --filter @lexaegis/contracts deploy:testnet",
    "test:chain:live": "pnpm --filter @lexaegis/contracts test:live",
    "test:review:browser": "tsx tooling/scripts/review-browser-check.ts",
    "agent:prompts:generate": "pnpm --filter @lexaegis/agent prompts:generate",
    "agent:prompts:check": "pnpm --filter @lexaegis/agent prompts:check",
    "test:assistant:browser": "tsx tooling/scripts/assistant-browser-check.ts",
    "qwen:smoke": "pnpm --filter @lexaegis/web smoke:qwen",
    "test:history:browser": "tsx tooling/scripts/history-browser-check.ts",
    "indexer:codegen": "pnpm --filter @lexaegis/indexer codegen",
    "indexer:check": "pnpm --filter @lexaegis/indexer config:check",
    "indexer:verify-binding": "pnpm --filter @lexaegis/indexer verify:binding",
    "test:indexer:rollback": "pnpm --filter @lexaegis/contracts test:indexer-rollback",
    "test:hud:browser": "tsx tooling/scripts/hud-browser-check.ts",
    "verifier:policy": "tsx tooling/scripts/verifier-policy.ts",
    "verifier:policy:check": "tsx tooling/scripts/verifier-policy.ts --check",
    "sdk:generate": "pnpm --filter @lexaegis/sdk generate",
    "sdk:check": "pnpm --filter @lexaegis/sdk generate:check",
    "packages:build": "tsx tooling/scripts/build-packages.ts",
    "packages:check": "tsx tooling/scripts/package-check.ts",
    "sdk:browser": "pnpm --filter @lexaegis/sdk test:browser"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@scure/bip32": "2.4.0",
    "@types/node": "26.6.4",
    "@vitest/browser-playwright": "5.0.3",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "json-canonicalize": "3.0.1",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
