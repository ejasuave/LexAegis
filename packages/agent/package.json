{
  "name": "@lexaegis/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Server-only review-agent runtime interfaces; ./contracts is the browser-safe data-types export.",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./review": "./src/review/index.ts",
    "./testing": "./src/testing/index.ts",
    "./testing/run-store-contract": "./src/testing/run-store-contract.ts",
    "./run-store": "./src/run-store.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prompts:generate": "tsx scripts/generate-prompts.ts",
    "prompts:check": "tsx scripts/generate-prompts.ts --check"
  },
  "dependencies": {
    "@lexaegis/protocol": "workspace:*",
    "diff": "9.0.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  }
}
