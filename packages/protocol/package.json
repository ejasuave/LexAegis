{
  "name": "@lexaegis/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Proof of Review protocol v1: schemas, strict parsing, canonical hashing, private commitments, offline package verification and the portable review bundle decoder.",
  "exports": {
    ".": "./src/index.ts",
    "./v1": "./src/v1/index.ts",
    "./portable": "./src/portable/index.ts",
    "./schemas/v1/*": "./schemas/v1/*",
    "./test-vectors/*": "./test-vectors/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "tsx scripts/generate-artifacts.ts",
    "generate:check": "tsx scripts/generate-artifacts.ts --check",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "vectors:export": "tsx scripts/export-test-vectors.ts",
    "vectors:check": "tsx scripts/export-test-vectors.ts --check",
    "vectors:ts-outcomes": "tsx scripts/ts-outcomes.ts"
  },
  "dependencies": {
    "canonicalize": "5.1.0",
    "jsonc-parser": "3.3.1",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "schemas",
    "test-vectors"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./v1": {
        "types": "./dist/v1/index.d.ts",
        "default": "./dist/v1/index.js"
      },
      "./portable": {
        "types": "./dist/portable/index.d.ts",
        "default": "./dist/portable/index.js"
      },
      "./schemas/v1/*": "./schemas/v1/*",
      "./test-vectors/*": "./test-vectors/*"
    }
  }
}
