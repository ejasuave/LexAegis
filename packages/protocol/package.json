{
  "name": "@lexaegis/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Framework-neutral Proof of Review schemas and domain types.",
  "exports": {
    ".": "./src/index.ts",
    "./v1": "./src/v1/index.ts",
    "./schemas/v1/*": "./schemas/v1/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "tsx scripts/generate-artifacts.ts",
    "generate:check": "tsx scripts/generate-artifacts.ts --check",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "canonicalize": "5.1.0",
    "jsonc-parser": "3.3.1",
    "zod": "4.6.5"
  }
}
